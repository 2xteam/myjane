# 통합 로그인용 — 회원 DB와 메일 발송에 필요하다.
# ⚠️ Vercel에서 NEXT_PUBLIC_* 은 반드시 **Config** 타입으로 등록할 것 (Secret이면 주입되지 않음)

# 회원은 user DB를 세 앱과 공유한다. URI 끝의 DB 이름은 아무거나 무방하다.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/user?retryWrites=true&w=majority
MONGO_USER_DB=user

# 세션 쿠키를 서브도메인 전체에서 공유 (Config 타입)
NEXT_PUBLIC_COOKIE_DOMAIN=.myjane.co.kr

# PIN 재설정 메일의 링크 기준 주소 (Config 타입)
NEXT_PUBLIC_BASE_URL=https://www.myjane.co.kr

# 메일 발송 (PIN 찾기)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
