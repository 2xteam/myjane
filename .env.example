# 통합 로그인용 — 회원 DB와 메일 발송에 필요하다.
# ⚠️ Vercel에서 NEXT_PUBLIC_* 은 반드시 **Config** 타입으로 등록할 것 (Secret이면 주입되지 않음)

# 회원은 user DB를 세 앱과 공유한다. URI 끝의 DB 이름은 아무거나 무방하다.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/user?retryWrites=true&w=majority
MONGO_USER_DB=user

# 세션 쿠키를 서브도메인 전체에서 공유 (Config 타입)
NEXT_PUBLIC_COOKIE_DOMAIN=.myjane.co.kr

# PIN 재설정 메일의 링크 기준 주소 (Config 타입)
NEXT_PUBLIC_BASE_URL=https://www.myjane.co.kr

# 메일 발송 (PIN 찾기)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 로컬 개발에서 각 앱을 `npm run dev:https` 로 띄웠다면 1 로 둔다.
# http 로 부르면 연결만 닫히고 fetch failed 로 보인다 (앱이 죽은 것처럼 보인다)
ADMIN_LOCAL_HTTPS=1

# 세션 서명 토큰 키 — 여섯 배포(포털·다섯 앱)가 **같은 값**을 가져야 한다. 없으면 모든 API 가 503
# → my-obsidian-vault / 30-Patterns/인증과 세션 공유.md
SESSION_SECRET=

# 구글 로그인 (포털에만). Google Cloud Console → OAuth 클라이언트 ID(웹). 리다이렉트 URI:
#   https://www.myjane.co.kr/api/auth/oauth/google/callback · http://localhost:3000/api/auth/oauth/google/callback
# → my-obsidian-vault / 50-Plans/G 소셜 로그인.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 로그인 (포털에만). Kakao Developers → 앱 키의 REST API 키. Client Secret 은 보안 탭에서 켰을 때만.
#   리다이렉트 URI: https://www.myjane.co.kr/api/auth/oauth/kakao/callback · http://localhost:3000/api/auth/oauth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
